# Secrets — never committed, in any branch, in any form
.env
.env.*
*.credentials.yaml
credentials*.yaml
secrets/
*.pem
*.key
*.p12

# DSH runtime state — lives in $DSH_HOME, must never be vendored here
.DSH_HOME/
dsh-home/

# Node
node_modules/
npm-debug.log*
*.tsbuildinfo

# Build output (shipped built at publish time, not tracked)
lib/
dist/
coverage/

# Spike artefacts: generated audio is reproducible and can embed a real voice;
# recorded event fixtures ARE tracked (they are the keyless-replay evidence).
spike/fixtures/audio/
spike/out/

# macOS
.DS_Store

# The self-test's per-run evidence: a diagnostic snapshot written every time anyone runs a check, not a
# record. The probe's evidence is kept when it is being filed for a review; these are not.
review-evidence/self-test-*.json

# pnpm owns the lockfile; an npm lockfile here is a stale duplicate.
package-lock.json

# npm writes a token into a project-level .npmrc when one is used, and a credential must never be
# committable — not even by accident, and not even briefly.
.npmrc
