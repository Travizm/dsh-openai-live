{
  "name": "dsh-realtime-audio-ws",
  "version": "0.1.0",
  "description": "The host end of the client half's transport: a WebSocket upgrade route that bridges microphone audio in and agent speech out.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "realtime",
    "voice",
    "audio",
    "websocket"
  ],
  "homepage": "https://github.com/Travizm/dsh-openai-live",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Travizm/dsh-openai-live.git",
    "directory": "packages/realtime-audio-ws"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --dry"
  },
  "dependencies": {
    "dsh-realtime-agent": "workspace:^",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/ws": "^8.18.2"
  }
}
