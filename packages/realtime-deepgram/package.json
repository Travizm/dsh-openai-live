{
  "name": "dsh-realtime-deepgram",
  "version": "0.1.0",
  "private": true,
  "description": "P5a \u2014 Deepgram Voice Agent: the Settings builder and the event translation, grounded in a recorded live session.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./settings": {
      "types": "./lib/settings.d.ts",
      "default": "./lib/settings.js"
    },
    "./events": {
      "types": "./lib/events.d.ts",
      "default": "./lib/events.js"
    },
    "./wire": {
      "types": "./lib/wire.d.ts",
      "default": "./lib/wire.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dsh-realtime": "workspace:^",
    "@deepseek-ai/schemastery": "^3.18.3",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "dsh": ">=0.2.0"
  }
}
