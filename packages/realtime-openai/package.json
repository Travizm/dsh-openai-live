{
  "name": "dsh-realtime-openai",
  "version": "0.1.1",
  "description": "GPT-Live-1 full-duplex voice adapter for the dsh-realtime seam, over the OpenAI Live WebSocket API.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "realtime",
    "voice",
    "full-duplex",
    "openai",
    "gpt-live"
  ],
  "homepage": "https://github.com/Travizm/dsh-openai-live",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Travizm/dsh-openai-live.git",
    "directory": "packages/realtime-openai"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --dry"
  },
  "dependencies": {
    "dsh-realtime": "workspace:^",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
